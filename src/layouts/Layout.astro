---
import "../styles/global.css";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path?: string;
}

const meta: Record<Lang, { title: string; description: string }> = {
  es: {
    title: "Casa Aroma — Restaurante",
    description:
      "Landing page responsive de restaurante de ejercicio educativo: carta, reservas y contacto.",
  },
  en: {
    title: "Casa Aroma — Restaurant",
    description:
      "Responsive sample restaurant landing page: menu, reservations and contact.",
  },
};

const { lang, title, description, path = "" } = Astro.props;
const pageTitle = title ?? meta[lang].title;
const pageDescription = description ?? meta[lang].description;

// Relative URLs work without `site` configured.
// TODO: when `site` is set in astro.config.mjs, these automatically become
// absolute via getAbsoluteLocaleUrl (required by Google for hreflang).
const esUrl = getRelativeLocaleUrl("es", path);
const enUrl = getRelativeLocaleUrl("en", path);
const esAbsoluteUrl = getAbsoluteLocaleUrl("es", path);
const enAbsoluteUrl = getAbsoluteLocaleUrl("en", path);
const useAbsolute = Boolean(Astro.site);
const hreflangEs = useAbsolute ? esAbsoluteUrl : esUrl;
const hreflangEn = useAbsolute ? enAbsoluteUrl : enUrl;
const hreflangDefault = hreflangEs;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={hreflangEs} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangDefault} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
