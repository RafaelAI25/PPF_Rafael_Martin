---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const esUrl = getRelativeLocaleUrl("es");
const enUrl = getRelativeLocaleUrl("en");
---

<nav aria-label="Language / Idioma" class="flex items-center gap-1 text-xs">
  <a
    href={esUrl}
    aria-current={lang === "es" ? "page" : undefined}
    class={lang === "es"
      ? "rounded-full bg-neutral-900 px-2.5 py-1 font-semibold text-white"
      : "rounded-full px-2.5 py-1 text-neutral-500 hover:text-neutral-900"}
  >
    ES
  </a>
  <a
    href={enUrl}
    aria-current={lang === "en" ? "page" : undefined}
    class={lang === "en"
      ? "rounded-full bg-neutral-900 px-2.5 py-1 font-semibold text-white"
      : "rounded-full px-2.5 py-1 text-neutral-500 hover:text-neutral-900"}
  >
    EN
  </a>
</nav>
