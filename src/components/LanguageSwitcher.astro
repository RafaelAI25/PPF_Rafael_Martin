---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const esUrl = getRelativeLocaleUrl("es");
const enUrl = getRelativeLocaleUrl("en");
---

<nav aria-label="Language / Idioma" class="flex items-center gap-1 text-xs">
  <a
    href={esUrl}
    aria-current={lang === "es" ? "page" : undefined}
    class={lang === "es"
      ? "rounded-full bg-teal-800 px-2.5 py-1 font-semibold text-cream"
      : "rounded-full px-2.5 py-1 text-stone-500 hover:text-teal-950"}
  >
    ES
  </a>
  <a
    href={enUrl}
    aria-current={lang === "en" ? "page" : undefined}
    class={lang === "en"
      ? "rounded-full bg-teal-800 px-2.5 py-1 font-semibold text-cream"
      : "rounded-full px-2.5 py-1 text-stone-500 hover:text-teal-950"}
  >
    EN
  </a>
</nav>
