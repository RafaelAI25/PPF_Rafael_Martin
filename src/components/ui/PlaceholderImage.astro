---
interface Props {
  title: string;
  ratio?: "video" | "portrait";
  rounded?: boolean;
}

const { title, ratio = "video", rounded = true } = Astro.props;

const ratioClass = ratio === "portrait" ? "aspect-[4/5]" : "aspect-video";
const roundedClass = rounded ? "rounded-2xl" : "";
---

<div
  role="img"
  aria-label={title}
  class={`flex w-full ${ratioClass} ${roundedClass} flex-col items-center justify-center border-2 border-dashed border-teal-800/25 bg-teal-950/5 px-4 text-center text-teal-900/70`}
>
  <span class="text-xs font-semibold uppercase tracking-widest">IMAGE PLACEHOLDER</span>
  <span class="text-sm font-medium sm:text-base">{title}</span>
</div>
