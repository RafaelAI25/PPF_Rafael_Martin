---
export interface Props {
  title: string;
  description: string;
  linkText: string;
  linkHref: string;
  iconVariant: "circle" | "square" | "diamond";
  titleId?: string;
}

const {
  title,
  description,
  linkText,
  linkHref,
  iconVariant,
  titleId,
} = Astro.props as Props;

const iconClass =
  iconVariant === "circle"
    ? "rounded-full bg-teal-800"
    : iconVariant === "square"
      ? "rounded-lg border border-teal-900/15 bg-lime-200"
      : "rotate-45 rounded-md border border-teal-900/15 bg-teal-800/10";
---

<article
  aria-labelledby={titleId}
  class="rounded-2xl border border-teal-950/10 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg focus-within:shadow-lg"
>
  <span aria-hidden="true" class={`block h-10 w-10 ${iconClass}`}></span>
  <h3 id={titleId} class="mt-4 text-lg font-bold text-teal-950">
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-stone-600">{description}</p>
  <p class="mt-4">
    <a
      href={linkHref}
      class="font-semibold text-teal-800 underline decoration-teal-600/40 underline-offset-4 transition hover:text-teal-900 hover:decoration-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {linkText}
    </a>
  </p>
</article>
