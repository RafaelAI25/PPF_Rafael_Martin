---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hours = ui[lang].footer.hours;

const homeUrl = getRelativeLocaleUrl(lang);
const infoLinks = [
  { label: t("footer.infoHome"), href: homeUrl },
  { label: t("footer.infoAbout"), href: "#features" },
  { label: t("footer.infoDocs"), href: "#docs" },
];
const menuLinks = [
  { label: t("footer.menuLinkMenu"), href: "#menu" },
  { label: t("footer.menuLinkDeals"), href: "#deals" },
];
---

<footer id="contacto" class="bg-teal-950 text-cream/75">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-lg font-black tracking-tight text-cream">
          {t("footer.brand")}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-cream/60">
          {t("footer.description")}
        </p>
        <address class="mt-5 space-y-1 text-sm not-italic">
          <p>{t("footer.address")}</p>
          <p>
            <a
              href={`mailto:${t("footer.email")}`}
              class="underline-offset-4 hover:text-cream hover:underline"
            >
              {t("footer.email")}
            </a>
          </p>
          <p>
            <a
              href={`tel:${t("footer.phone").replace(/\s/g, "")}`}
              class="underline-offset-4 hover:text-cream hover:underline"
            >
              {t("footer.phone")}
            </a>
          </p>
        </address>
      </div>

      <nav aria-label={t("footer.infoTitle")}>
        <h2 class="text-sm font-bold uppercase tracking-[0.18em] text-cream">
          {t("footer.infoTitle")}
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="underline-offset-4 hover:text-cream hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t("footer.menuTitle")}>
        <h2 class="text-sm font-bold uppercase tracking-[0.18em] text-cream">
          {t("footer.menuTitle")}
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            menuLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="underline-offset-4 hover:text-cream hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-[0.18em] text-cream">
          {t("footer.hoursTitle")}
        </h2>
        <dl class="mt-4 space-y-2 text-sm">
          {
            hours.map((slot) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-cream/60">{slot.day}</dt>
                <dd class="text-cream/85">{slot.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="mt-12 border-t border-cream/15 pt-6 text-center text-sm text-cream/60">
      <p>{t("footer.rights")}</p>
    </div>
  </div>
</footer>
