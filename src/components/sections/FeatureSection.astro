---
import PlaceholderImage from "../ui/PlaceholderImage.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  features?: string[];
  buttonText?: string;
  buttonHref?: string;
  imagePosition: "left" | "right";
  imagePlaceholderText: string;
  sectionId?: string;
  titleId?: string;
}

const {
  eyebrow,
  title,
  description,
  features = [],
  buttonText,
  buttonHref = "#",
  imagePosition,
  imagePlaceholderText,
  sectionId,
  titleId,
} = Astro.props as Props;

const imageOrderClass =
  imagePosition === "left" ? "order-1" : "order-1 lg:order-2";
const contentOrderClass =
  imagePosition === "left" ? "order-2" : "order-2 lg:order-1";
---

<section id={sectionId} aria-labelledby={titleId} class="bg-white">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:py-24"
  >
    <div class={imageOrderClass}>
      <PlaceholderImage title={imagePlaceholderText} />
    </div>
    <div class={contentOrderClass}>
      {eyebrow && (
        <p
          class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
        >
          {eyebrow}
        </p>
      )}
      <h2
        id={titleId}
        class="mt-2 text-3xl font-extrabold tracking-tight text-balance text-neutral-900 sm:text-4xl"
      >
        {title}
      </h2>
      <p class="mt-4 text-base text-neutral-600 sm:text-lg">{description}</p>
      {features.length > 0 && (
        <ul class="mt-6 list-disc space-y-2 pl-5 text-neutral-700">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      )}
      {buttonText && (
        <p class="mt-8">
          <a
            href={buttonHref}
            class="inline-block rounded-full bg-neutral-900 px-8 py-3 text-center text-white"
          >
            {buttonText}
          </a>
        </p>
      )}
    </div>
  </div>
</section>
