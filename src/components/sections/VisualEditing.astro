---
import FeatureSection from "./FeatureSection.astro";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<FeatureSection
  eyebrow={t("sections.visualEditing.eyebrow")}
  title={t("sections.visualEditing.title")}
  description={t("sections.visualEditing.description")}
  buttonText={t("sections.visualEditing.buttonText")}
  buttonHref={t("sections.visualEditing.buttonHref")}
  imagePosition="left"
  imagePlaceholderText={t("sections.visualEditing.imagePlaceholderText")}
  sectionId="features"
  titleId="editing-title"
/>
