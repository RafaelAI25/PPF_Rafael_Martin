---
import PlaceholderImage from "../ui/PlaceholderImage.astro";
import { ui, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const advantages = ui[lang].sections.openSource.bullets;
const buttonHref = t("sections.openSource.buttonHref");
const isExternal = buttonHref.startsWith("http");
---

<section id="opensource" aria-labelledby="opensource-title" class="bg-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <div
      class="relative overflow-hidden rounded-3xl bg-teal-900 px-6 py-12 text-center shadow-lg sm:px-12 lg:px-16 lg:py-16"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[42rem] max-w-none -translate-x-1/2 rounded-full bg-lime-200/10 blur-2xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 -left-16 h-64 w-64 rounded-full bg-white/5 blur-2xl"
      >
      </div>
      <div class="relative mx-auto max-w-3xl">
        <p
          class="text-xs font-bold uppercase tracking-[0.18em] text-lime-200/70"
        >
          {t("sections.openSource.eyebrow")}
        </p>
        <h2
          id="opensource-title"
          class="mt-3 text-3xl font-black tracking-[-0.02em] text-balance text-cream md:text-4xl"
        >
          {t("sections.openSource.title")}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-cream/75 sm:text-lg">
          {t("sections.openSource.description")}
        </p>
        <ul
          class="mt-6 flex flex-col items-center justify-center gap-2 text-sm font-medium text-cream/85 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-2"
        >
          {
            advantages.map((advantage) => (
              <li class="flex items-center gap-2">
                <span
                  aria-hidden="true"
                  class="block h-1.5 w-1.5 rounded-full bg-lime-200"
                />
                {advantage}
              </li>
            ))
          }
        </ul>
        <p class="mt-8">
          <a
            href={buttonHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener" : undefined}
            class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-lime-200 px-7 py-3 text-center text-sm font-semibold uppercase tracking-wider text-teal-950 transition duration-200 hover:-translate-y-0.5 hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {t("sections.openSource.buttonText")}
          </a>
        </p>
      </div>
      <div class="relative mx-auto mt-10 max-w-4xl">
        <PlaceholderImage title={t("sections.openSource.imagePlaceholderText")} />
      </div>
    </div>
  </div>
</section>
