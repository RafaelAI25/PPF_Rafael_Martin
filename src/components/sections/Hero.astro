---
import PlaceholderImage from "../ui/PlaceholderImage.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section aria-labelledby="hero-title" class="bg-cream">
  <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 text-center sm:px-6 md:pb-20 md:pt-24">
    <h1
      id="hero-title"
      class="mx-auto max-w-4xl text-4xl font-black tracking-[-0.03em] text-balance text-teal-950 sm:text-5xl lg:text-6xl"
    >
      {t("hero.titleStart")} <strong class="text-teal-700 underline decoration-2 underline-offset-4"
        >{t("hero.titleHighlight")}</strong
      > {t("hero.titleEnd")}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-base text-stone-600 sm:text-lg">
      {t("hero.description")}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a
        href="#menu"
        class="inline-flex min-h-[2.75rem] w-full items-center justify-center rounded-full bg-teal-800 px-7 py-3 text-center text-sm font-semibold uppercase tracking-wider text-cream transition duration-200 hover:-translate-y-0.5 hover:bg-teal-900 sm:w-auto"
      >
        {t("hero.ctaPrimary")}
      </a>
      <a
        href="#features"
        class="inline-flex min-h-[2.75rem] w-full items-center justify-center rounded-full border border-teal-900/15 bg-lime-200 px-7 py-3 text-center text-sm font-semibold uppercase tracking-wider text-teal-950 transition duration-200 hover:-translate-y-0.5 hover:bg-lime-100 sm:w-auto"
      >
        {t("hero.ctaSecondary")}
      </a>
    </div>
    <div class="mt-10 sm:mt-12 lg:mt-16">
      <PlaceholderImage title={t("hero.imageLabel")} ratio="video" />
    </div>
  </div>
</section>
