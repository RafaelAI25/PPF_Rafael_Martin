---
import PlaceholderImage from "../ui/PlaceholderImage.astro";
import { ui, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Offer {
  title: string;
  description: string;
  price: string;
}

const offers: Offer[] = ui[lang].deals.items;
---

<section id="deals" aria-labelledby="deals-title" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <h2
      id="deals-title"
      class="text-center text-3xl font-black tracking-[-0.02em] text-balance text-teal-950 md:text-4xl"
    >
      {t("deals.title")}
    </h2>
    <p
      class="mx-auto mt-4 max-w-2xl text-center text-base text-stone-600 sm:text-lg"
    >
      {t("deals.subtitle")}
    </p>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        offers.map((offer, index) => (
          <article
            aria-labelledby={`deal-${index + 1}`}
            class="rounded-2xl border border-teal-950/10 bg-cream p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg"
          >
            <PlaceholderImage title={offer.title} ratio="portrait" />
            <h3
              id={`deal-${index + 1}`}
              class="mt-4 text-lg font-bold text-teal-950"
            >
              {offer.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{offer.description}</p>
            <p class="mt-4">
              <span class="inline-block rounded-full bg-teal-800 px-4 py-1.5 text-lg font-black text-cream">
                {offer.price}
              </span>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
